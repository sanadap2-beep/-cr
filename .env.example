# =====================================================================
# انسخ هذا الملف إلى .env واملأ القيم. ملف .env مُستثنى من git.
# =====================================================================

# --- مطلوب -----------------------------------------------------------

# توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=

# معرف التليجرام الرقمي حقك (مو اسم المستخدم)
OWNER_ID=

# --- اختياري ---------------------------------------------------------

SESSION_NAME=session
CHANNEL_ID=
GROUP_ID=
THUMB_URL=

DEFAULT_COOLDOWN=20
MAX_RETRIES=3
RECONNECT_DELAY=2000
MAINTENANCE_MODE=false
MAX_SESSIONS=10
AUTO_RECONNECT=true
ANTI_SPAM=true
RATE_LIMIT=30

# silent | error | warn | info | debug | trace
# استخدم debug أو trace عند تشخيص مشاكل الاتصال بواتساب
LOG_LEVEL=info

# لو فشل جلب إصدار واتساب من الإنترنت، استخدم الإصدار المضمّن في المكتبة
OFFLINE_VERSION_FALLBACK=true
