{
  "name": "raju-bot",
  "version": "12.0.1",
  "description": "Telegram-controlled WhatsApp client manager",
  "main": "raju.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node raju.js",
    "doctor": "node scripts/wa-doctor.js",
    "config:check": "node -e \"const e=require('./config').validate(); if(e.length){console.error('\\nإعدادات ناقصة:'); e.forEach(x=>console.error(' - '+x)); process.exit(1)} console.log('✓ الإعدادات سليمة')\"",
    "selftest": "node scripts/selftest.js",
    "test": "node scripts/selftest.js"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.24",
    "axios": "^1.7.7",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "grammy": "^1.38.3",
    "pino": "^8.21.0"
  }
}
